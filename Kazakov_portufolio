<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zafarbek — Frontend Dasturchi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --base:#120D1F;
    --base-2:#1C1630;
    --ink:#F3EFFC;
    --ink-soft:#A79ECC;
    --purple:#9D7BFF;
    --green:#2DD4A7;
    --blue:#5B8DEF;
    --pink:#F76E8B;
    --amber:#F5B94D;
    --line:#332A54;
    --nav-bg:rgba(18,13,31,0.85);
    --bar-bg:#251D3E;
    --note-bg:rgba(245,185,77,0.08);
    --shadow: 0 1px 2px rgba(0,0,0,0.25), 0 8px 28px rgba(0,0,0,0.4);
  }

  body.light{
    --base:#FCFBFF;
    --base-2:#FFFFFF;
    --ink:#17121F;
    --ink-soft:#635B7A;
    --purple:#7C3AED;
    --green:#0F9E77;
    --blue:#2563EB;
    --pink:#E11D5A;
    --amber:#C97A0A;
    --line:#E4DEF2;
    --nav-bg:rgba(252,251,255,0.85);
    --bar-bg:#F1EDFA;
    --note-bg:#FFF6E6;
    --shadow: 0 1px 2px rgba(23,18,31,0.05), 0 8px 24px rgba(23,18,31,0.07);
  }

  body{ transition:background-color .3s ease, color .3s ease; }

  .theme-toggle{
    display:flex; align-items:center; gap:8px;
    background:var(--base-2);
    border:1px solid var(--line);
    color:var(--ink);
    font-family:'JetBrains Mono', monospace;
    font-size:0.78rem;
    padding:8px 12px;
    border-radius:8px;
    cursor:pointer;
    transition:transform .18s ease, border-color .18s ease;
  }
  .theme-toggle:hover{ transform:translateY(-2px); border-color:var(--purple); }
  .theme-toggle .icon{ width:14px; height:14px; display:inline-flex; }
  .theme-toggle .icon svg{ width:100%; height:100%; }

  *{ box-sizing:border-box; margin:0; padding:0; }

  html{ scroll-behavior:smooth; }

  body{
    background:var(--base);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    line-height:1.6;
    overflow-x:hidden;
  }

  a{ color:inherit; text-decoration:none; }

  .mono{ font-family:'JetBrains Mono', monospace; }
  .display{ font-family:'Space Grotesk', sans-serif; }

  ::selection{ background:var(--purple); color:#fff; }

  a:focus-visible, button:focus-visible{
    outline:3px solid var(--blue);
    outline-offset:3px;
    border-radius:4px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important; }
  }

  .wrap{ max-width:1040px; margin:0 auto; padding:0 24px; }

  /* NAV */
  nav{
    position:sticky; top:0; z-index:50;
    background:var(--nav-bg);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{ display:flex; align-items:center; justify-content:space-between; gap:16px; padding-top:18px; padding-bottom:18px; }
  .brand{ font-family:'JetBrains Mono', monospace; font-weight:600; font-size:1.05rem; display:flex; align-items:center; gap:2px; }
  .brand .tag{ color:var(--purple); }
  .brand .name{ color:var(--ink); }
  .navlinks{ display:flex; gap:28px; font-family:'JetBrains Mono', monospace; font-size:0.85rem; }
  .navlinks a{ color:var(--ink-soft); position:relative; padding-bottom:2px; transition:color .2s; }
  .navlinks a:hover{ color:var(--purple); }
  .navlinks a::before{ content:"·"; color:var(--amber); margin-right:6px; }
  .nav-toggle{ display:none; background:none; border:none; cursor:pointer; }
  @media(max-width:680px){
    .navlinks{ display:none; }
  }

  /* HERO */
  .hero{ padding:88px 0 70px; }
  .editor{
    background:var(--base-2);
    border:1px solid var(--line);
    border-radius:16px;
    box-shadow:var(--shadow);
    overflow:hidden;
  }
  .editor-bar{
    display:flex; align-items:center; gap:8px;
    padding:14px 18px;
    background:var(--bar-bg);
    border-bottom:1px solid var(--line);
  }
  .dot{ width:11px; height:11px; border-radius:50%; }
  .dot.r{ background:var(--pink); }
  .dot.y{ background:var(--amber); }
  .dot.g{ background:var(--green); }
  .filename{ margin-left:10px; font-family:'JetBrains Mono', monospace; font-size:0.78rem; color:var(--ink-soft); }
  .editor-body{ padding:34px clamp(18px,4vw,44px); font-family:'JetBrains Mono', monospace; }
  .code-line{ font-size:clamp(1rem, 2.6vw, 1.5rem); line-height:1.9; white-space:pre-wrap; }
  .k{ color:var(--purple); font-weight:600; }
  .s{ color:var(--green); }
  .p{ color:var(--blue); }
  .c{ color:var(--ink-soft); }
  .caret{
    display:inline-block; width:2px; height:1em; background:var(--pink);
    vertical-align:middle; animation:blink 1s steps(1) infinite;
  }
  @keyframes blink{ 50%{ opacity:0; } }

  .hero-sub{
    margin-top:26px;
    font-size:1.05rem;
    color:var(--ink-soft);
    max-width:560px;
  }
  .hero-sub strong{ color:var(--ink); }

  .cta-row{ margin-top:30px; display:flex; gap:14px; flex-wrap:wrap; }
  .btn{
    font-family:'JetBrains Mono', monospace;
    font-size:0.88rem;
    padding:13px 22px;
    border-radius:10px;
    display:inline-flex; align-items:center; gap:8px;
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .btn-primary{ background:var(--purple); color:#fff; box-shadow:0 6px 18px rgba(124,58,237,0.35); }
  .btn-primary:hover{ transform:translateY(-2px); box-shadow:0 10px 22px rgba(124,58,237,0.42); }
  .btn-ghost{ background:var(--base-2); color:var(--ink); border:1px solid var(--line); }
  .btn-ghost:hover{ transform:translateY(-2px); border-color:var(--purple); }

  /* SECTION LABELS */
  .section{ padding:64px 0; }
  .section-head{ margin-bottom:34px; }
  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:0.82rem;
    color:var(--green);
  }
  .eyebrow::before{ content:"// "; color:var(--ink-soft); }
  h2.display{ font-size:clamp(1.6rem,4vw,2.2rem); margin-top:6px; }

  /* ABOUT */
  .about-card{
    background:var(--base-2);
    border:1px solid var(--line);
    border-radius:16px;
    padding:clamp(22px,4vw,40px);
    box-shadow:var(--shadow);
    display:grid;
    grid-template-columns:auto 1fr;
    gap:28px;
    align-items:start;
  }
  @media(max-width:640px){ .about-card{ grid-template-columns:1fr; } }
  .avatar{
    width:84px; height:84px; border-radius:16px;
    background:linear-gradient(135deg,var(--purple),var(--blue) 50%, var(--pink));
    display:flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.7rem; color:#fff;
    flex-shrink:0;
  }
  .about-text p{ color:var(--ink-soft); font-size:1.02rem; }
  .about-text p + p{ margin-top:12px; }
  .stat-row{ display:flex; gap:26px; margin-top:20px; flex-wrap:wrap; }
  .stat{ font-family:'JetBrains Mono', monospace; }
  .stat b{ font-family:'Space Grotesk',sans-serif; display:block; font-size:1.5rem; color:var(--purple); }
  .stat span{ font-size:0.78rem; color:var(--ink-soft); }

  /* SKILLS */
  .import-line{ font-family:'JetBrains Mono', monospace; color:var(--ink-soft); font-size:0.95rem; margin-bottom:18px; }
  .import-line .k{ color:var(--purple); }
  .import-line .p{ color:var(--blue); }
  .tags{ display:flex; flex-wrap:wrap; gap:12px; }
  .tag{
    font-family:'JetBrains Mono', monospace;
    font-size:0.9rem;
    padding:10px 16px;
    border-radius:9px;
    background:var(--base-2);
    border:1px solid var(--line);
    display:flex; align-items:center; gap:8px;
    transition:transform .18s ease, border-color .18s ease;
  }
  .tag:hover{ transform:translateY(-3px); }
  .tag .sw{ width:9px; height:9px; border-radius:50%; }

  /* PROJECTS */
  .proj-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:20px; }
  .proj-card{
    background:var(--base-2);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
    box-shadow:var(--shadow);
    transition:transform .2s ease;
  }
  .proj-card:hover{ transform:translateY(-4px); }
  .proj-tab{
    display:flex; align-items:center; gap:8px;
    padding:11px 16px;
    font-family:'JetBrains Mono', monospace;
    font-size:0.76rem;
    color:var(--ink-soft);
    border-bottom:1px solid var(--line);
  }
  .proj-tab .sq{ width:8px; height:8px; border-radius:2px; }
  .proj-body{ padding:20px 18px 22px; }
  .proj-body h3{ font-family:'Space Grotesk',sans-serif; font-size:1.12rem; margin-bottom:8px; }
  .proj-body p{ color:var(--ink-soft); font-size:0.92rem; }
  .proj-stack{ margin-top:14px; display:flex; gap:6px; flex-wrap:wrap; }
  .chip{ font-family:'JetBrains Mono', monospace; font-size:0.72rem; padding:4px 9px; border-radius:6px; background:var(--base); color:var(--ink-soft); }
  .note{
    margin-top:20px; font-size:0.85rem; color:var(--ink-soft);
    font-family:'JetBrains Mono', monospace;
    border-left:3px solid var(--amber);
    padding:10px 14px;
    background:var(--note-bg);
    border-radius:0 8px 8px 0;
  }

  /* CONTACT */
  .terminal{
    background:#1A1523;
    border-radius:16px;
    overflow:hidden;
    box-shadow:var(--shadow);
  }
  .terminal-bar{ display:flex; align-items:center; gap:8px; padding:14px 18px; background:#241C33; }
  .terminal-bar .filename{ color:#9C93B5; }
  .terminal-body{ padding:30px clamp(18px,4vw,40px) 36px; font-family:'JetBrains Mono', monospace; color:#E7E2FA; }
  .term-line{ font-size:0.95rem; margin-bottom:10px; }
  .term-line .prompt{ color:var(--green); }
  .term-line .arg{ color:var(--amber); }
  .contact-links{ margin-top:22px; display:flex; gap:14px; flex-wrap:wrap; }
  .clink{
    font-family:'JetBrains Mono', monospace;
    font-size:0.9rem;
    padding:12px 18px;
    border-radius:10px;
    background:#2C2240;
    border:1px solid #3B2E57;
    color:#fff;
    display:flex; align-items:center; gap:8px;
    transition:transform .18s ease, background .18s ease;
  }
  .clink:hover{ transform:translateY(-2px); background:var(--purple); }
  .clink .sw{ width:8px; height:8px; border-radius:50%; }

  footer{ padding:30px 0 50px; text-align:center; }
  footer p{ font-family:'JetBrains Mono', monospace; font-size:0.78rem; color:var(--ink-soft); }

  /* scroll reveal */
  .reveal{ opacity:0; transform:translateY(16px); transition:opacity .6s ease, transform .6s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <div class="brand"><span class="tag">&lt;/&gt;</span><span class="name">&nbsp;Zafarbek</span></div>
    <div class="navlinks">
      <a href="#about">about</a>
      <a href="#skills">skills</a>
      <a href="#projects">projects</a>
      <a href="#contact">contact</a>
    </div>
    <button class="theme-toggle" id="themeToggle" aria-label="Mavzuni almashtirish">
      <span class="icon" id="themeIcon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </span>
      <span id="themeLabel">Dark</span>
    </button>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <div class="editor">
      <div class="editor-bar">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
        <span class="filename">zafarbek.js</span>
      </div>
      <div class="editor-body">
        <div class="code-line"><span class="k">const</span> <span class="p">developer</span> = {</div>
        <div class="code-line">&nbsp;&nbsp;name: <span class="s">"Zafarbek"</span>,</div>
        <div class="code-line">&nbsp;&nbsp;role: <span class="s">"Frontend dasturchi"</span>,</div>
        <div class="code-line">&nbsp;&nbsp;experience: <span class="s">"2 yil"</span>,</div>
        <div class="code-line">&nbsp;&nbsp;stack: [<span class="s">"JavaScript"</span>, <span class="s">"HTML"</span>, <span class="s">"CSS"</span>]<span class="caret"></span></div>
        <div class="code-line">};</div>
      </div>
    </div>
    <p class="hero-sub">Men <strong>Zafarbek</strong> — foydalanuvchi tajribasiga e'tiborli, chiroyli va tez ishlaydigan interfeyslar yarataman. So'nggi 2 yildan beri veb-sahifalar ustida ishlab kelaman: statikdan tortib interaktiv ilovalargacha.</p>
    <div class="cta-row">
      <a href="#projects" class="btn btn-primary">Loyihalarni ko'rish →</a>
      <a href="#contact" class="btn btn-ghost">Bog'lanish</a>
    </div>
  </div>
</header>

<section class="section" id="about">
  <div class="wrap">
    <div class="section-head reveal">
       
      <h2 class="display">Men haqimda</h2>
    </div>
    <div class="about-card reveal">
      <div class="avatar">Z</div>
      <div class="about-text">
        <p>Men frontend yo'nalishida ishlaydigan dasturchiman. Ishimda foydalanuvchi birinchi o'rinda turadi — shuning uchun har bir interfeysni tez, tushunarli va chiroyli qilishga harakat qilaman.</p>
        <p>JavaScript, HTML va CSS — bu mening kundalik quролlarim. 2 yillik tajribam davomida turli xil sahifalar va kichik ilovalar ustida ishlaganman, har bir loyihada nimadir yangi o'rganib boraman.</p>
        <div class="stat-row">
          <div class="stat"><b>2+</b><span>yil tajriba</span></div>
          <div class="stat"><b>3</b><span>asosiy texnologiya</span></div>
          <div class="stat"><b>100%</b><span>detallarga e'tibor</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="skills">
  <div class="wrap">
    <div class="section-head reveal">
      
      <h2 class="display">Ko'nikmalar</h2>
    </div>
    <div class="reveal">
      <div class="import-line"><span class="k">import</span> { skills } <span class="k">from</span> <span class="p">"./zafarbek"</span>;</div>
      <div class="tags">
        <span class="tag"><span class="sw" style="background:var(--amber)"></span>JavaScript</span>
        <span class="tag"><span class="sw" style="background:var(--pink)"></span>HTML5</span>
        <span class="tag"><span class="sw" style="background:var(--blue)"></span>CSS3</span>
        <span class="tag"><span class="sw" style="background:var(--purple)"></span>Responsive Design</span>
        <span class="tag"><span class="sw" style="background:var(--green)"></span>Git &amp; GitHub</span>
      </div>
    </div>
  </div>
</section>

<section class="section" id="projects">
  <div class="wrap">
    <div class="section-head reveal">
   
      <h2 class="display">Loyihalar</h2>
    </div>
    <div class="proj-grid reveal">
      <div class="proj-card">
        <div class="proj-tab"><span class="sq" style="background:var(--amber)"></span>project-1.html</div>
        <div class="proj-body">
          <h3>Loyiha nomi</h3>
          <p>Qisqacha tavsif — bu yerga loyihangiz haqida 1-2 gap yozing.</p>
          <div class="proj-stack"><span class="chip">HTML</span><span class="chip">CSS</span><span class="chip">JS</span></div>
        </div>
      </div>
      <div class="proj-card">
        <div class="proj-tab"><span class="sq" style="background:var(--blue)"></span>project-2.html</div>
        <div class="proj-body">
          <h3>Loyiha nomi</h3>
          <p>Qisqacha tavsif — bu yerga loyihangiz haqida 1-2 gap yozing.</p>
          <div class="proj-stack"><span class="chip">HTML</span><span class="chip">CSS</span><span class="chip">JS</span></div>
        </div>
      </div>
      <div class="proj-card">
        <div class="proj-tab"><span class="sq" style="background:var(--green)"></span>project-3.html</div>
        <div class="proj-body">
          <h3>Loyiha nomi</h3>
          <p>Qisqacha tavsif — bu yerga loyihangiz haqida 1-2 gap yozing.</p>
          <div class="proj-stack"><span class="chip">HTML</span><span class="chip">CSS</span><span class="chip">JS</span></div>
        </div>
      </div>
    </div>
    <p class="note reveal">// Eslatma: yuqoridagi 3 ta karta — namuna. O'z loyihalaringiz nomi, tavsifi va (agar bo'lsa) linkini shu yerga qo'yasiz.</p>
  </div>
</section>

<section class="section" id="contact">
  <div class="wrap">
    <div class="section-head reveal">
       
      <h2 class="display">Bog'lanish</h2>
    </div>
    <div class="terminal reveal">
      <div class="terminal-bar">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
        <span class="filename">~/zafarbek/contact</span>
      </div>
      <div class="terminal-body">
        <div class="term-line"><span class="prompt">$</span> in the agreed-upon state</div>
        <div class="term-line">Zafarbek — Frontend Developer</div>
        <div class="term-line"><span class="prompt">$</span> contact <span class="arg">--phone</span></div>
        <div class="term-line">+998 77 969 17 04</div>
        <div class="contact-links">
          <a class="clink" href="tel:+998779691704"><span class="sw" style="background:var(--green)"></span>Qo'ng'iroq qilish</a>
          <a class="clink" href="https://t.me/+998779691704"><span class="sw" style="background:var(--blue)"></span>Telegram</a>
          <a class="clink" href="https://wa.me/998779691704"><span class="sw" style="background:var(--amber)"></span>WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<footer>
  <p>© 2026 Zafarbek — barcha huquqlar himoyalangan</p>
</footer>

<script>
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold:0.12 });
  revealEls.forEach(el=>io.observe(el));

  const themeToggle = document.getElementById('themeToggle');
  const themeLabel = document.getElementById('themeLabel');
  themeToggle.addEventListener('click', ()=>{
    document.body.classList.toggle('light');
    const isLight = document.body.classList.contains('light');
    themeLabel.textContent = isLight ? 'Light' : 'Dark';
  });
</script>

</body>
</html>
